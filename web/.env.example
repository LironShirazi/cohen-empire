# העתיקו ל-.env.local ומלאו מהערכים של פרויקט ה-Supabase
# (Supabase Dashboard ← Project Settings ← API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# אופציונלי — הדומיין של האתר, לכתובות מלאות ב-og:image.
# בוורסל נגזר אוטומטית ואין צורך להגדיר.
NEXT_PUBLIC_SITE_URL=https://<your-domain>

# אופציונלי — ה-Client ID של Google (Google Cloud ← Clients, אותו אחד שמוגדר
# ב-Supabase). כשמוגדר, ההתחברות עוברת דרך /auth/google ומסך Google מציג את
# הדומיין של האפליקציה במקום <project-ref>.supabase.co
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com

# התראות Push והתקנה למסך הבית (CLAUDE.md §23) — אופציונלי; בלי זה הכפתורים
# לא מוצגים. יצירת מפתחות:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<public-key>
VAPID_PRIVATE_KEY=<private-key>
# מייל או כתובת האתר — נדרש ע"י שירותי ה-Push לזיהוי השולח
VAPID_SUBJECT=mailto:you@example.com
# Supabase Dashboard ← Project Settings ← API ← service_role. סודי: צד שרת בלבד,
# עוקף RLS, ולא לשים עם NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
