# העתיקו ל-.env.local ומלאו מהערכים של פרויקט ה-Supabase
# (Supabase Dashboard ← Project Settings ← API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# אופציונלי — הדומיין של האתר, לכתובות מלאות ב-og:image.
# בוורסל נגזר אוטומטית ואין צורך להגדיר.
NEXT_PUBLIC_SITE_URL=https://<your-domain>

# אופציונלי — ה-Client ID של Google (Google Cloud ← Clients, אותו אחד שמוגדר
# ב-Supabase). כשמוגדר, ההתחברות עוברת דרך /auth/google ומסך Google מציג את
# הדומיין של האפליקציה במקום <project-ref>.supabase.co
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com

# אופציונלי — Cloudflare R2 לגלריה (מיגרציה 0022). כשכל החמישה מוגדרים,
# כל העלאה חדשה לגלריה הולכת ל-R2; בלעדיהם — ל-Supabase כמו קודם.
# צד שרת בלבד, בלי NEXT_PUBLIC_. מפתח API: R2 ← Manage API tokens,
# הרשאת Object Read & Write על ה-bucket הזה בלבד.
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<access-key-id>
R2_SECRET_ACCESS_KEY=<secret-access-key>
R2_BUCKET=cohen-gallery
# הכתובת הציבורית של ה-bucket — דומיין מותאם, או pub-….r2.dev לבדיקות
R2_PUBLIC_URL=https://<public-bucket-url>
